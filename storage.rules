rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Firma del coordinador: solo él la sube y la lee. PNG de máximo 1 MB.
    match /users/{uid}/firma/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && file == 'firma.png'
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'image/png';
    }

    // Planillas generadas: las escribe el servidor; el dueño puede leerlas.
    match /users/{uid}/planillas/{eventId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
