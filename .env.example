# Firebase cliente (Configuración del proyecto > Tus apps > App web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pegar entre comillas, con los \n tal cual vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Administración: correo exacto y verificado de Victor
ADMIN_EMAIL=victor@example.com
NEXT_PUBLIC_ADMIN_EMAIL=victor@example.com

# App Check (reCAPTCHA v3). Opcional.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# "true" exige token de App Check en todas las rutas /api
APP_CHECK_ENFORCE=false

# Correo de contacto que aparece en el aviso de privacidad
NEXT_PUBLIC_CONTACT_EMAIL=


# Cuenta de cobro: lectura del consolidado con Gemini (solo servidor).
# Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo preferido (por defecto gemini-3.5-flash-lite, con respaldo automático)
GEMINI_MODEL=

# PDF oficial de cuenta de cobro (Gotenberg con LibreOffice). Solo servidor.
GOTENBERG_URL=
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
NEXT_PUBLIC_PDF_CONVERTER_ENABLED=false
