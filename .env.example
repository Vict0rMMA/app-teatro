# Firebase cliente (Configuración del proyecto > Tus apps > App web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pegar entre comillas, con los \n tal cual vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# App Check (reCAPTCHA v3). Opcional.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# "true" exige token de App Check en todas las rutas /api
APP_CHECK_ENFORCE=false

# Correo de contacto que aparece en el aviso de privacidad
NEXT_PUBLIC_CONTACT_EMAIL=

