rules_version = '2';

// Cada coordinador solo ve y modifica documentos con su uid.
// "events" y su "staff" los crea el servidor (firebase-admin) al generar planillas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function owns() {
      return isOwner(resource.data.uid);
    }
    function createsOwn() {
      return isOwner(request.resource.data.uid);
    }
    function keepsOwner() {
      return request.resource.data.uid == resource.data.uid;
    }
    function isTime(v) {
      return v == null || (v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$'));
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validWorkLog(d) {
      return d.keys().hasOnly(['uid', 'eventId', 'evento', 'placeId', 'fecha', 'llegada', 'salida', 'horas', 'valor', 'origen', 'createdAt', 'updatedAt'])
        && isDate(d.fecha)
        && d.placeId is string
        && d.evento is string && d.evento.size() <= 160
        && isTime(d.llegada) && isTime(d.salida)
        && (d.horas == null || (d.horas is number && d.horas >= 0 && d.horas <= 24))
        && (d.valor == null || (d.valor is number && d.valor >= 0));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && (request.resource.data.firmaPath == null
            || request.resource.data.firmaPath == 'users/' + uid + '/firma/firma.png');
    }

    match /events/{eventId} {
      allow read, delete: if owns();
      // Solo se pueden editar los textos del resumen; los archivos los gestiona el servidor.
      allow update: if owns() && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['aforo', 'observaciones', 'objetosPerdidos', 'whatsapp']);
      allow create: if false;

      match /staff/{staffId} {
        allow read, delete: if owns();
        allow write: if false;
      }
    }

    // Búsqueda de personal en todos los eventos (collectionGroup).
    match /{path=**}/staff/{staffId} {
      allow read: if owns();
    }

    match /workLogs/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn() && validWorkLog(request.resource.data);
      allow update: if owns() && keepsOwner() && validWorkLog(request.resource.data);
    }

    match /workPlaces/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60;
      allow update: if owns() && keepsOwner()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60;
    }

    // Contadores del rate limit: solo el servidor.
    match /rateLimits/{id} {
      allow read, write: if false;
    }
  }
}
