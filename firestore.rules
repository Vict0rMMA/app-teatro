rules_version = '2';

// Plan Spark (sin Storage). Cada coordinador solo ve y modifica documentos con su uid.
// "events" y su "staff" los crea el servidor (firebase-admin) al generar planillas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function owns() {
      return isOwner(resource.data.uid);
    }
    function createsOwn() {
      return isOwner(request.resource.data.uid);
    }
    function keepsOwner() {
      return request.resource.data.uid == resource.data.uid;
    }
    // Permisos por sección (permisos/{uid}.secciones; los escribe solo el servidor).
    // Sin documento = acceso completo (por defecto); con documento, solo las secciones marcadas.
    function permisos() {
      return /databases/$(database)/documents/permisos/$(request.auth.uid);
    }
    function tiene(seccion) {
      return signedIn() && (!exists(permisos()) || seccion in get(permisos()).data.secciones);
    }
    function isTime(v) {
      return v == null || (v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$'));
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validWorkLog(d) {
      return d.keys().hasOnly(['uid', 'eventId', 'evento', 'placeId', 'fecha', 'llegada', 'salida', 'horas', 'valor', 'origen', 'paraQuien', 'createdAt', 'updatedAt'])
        && isDate(d.fecha)
        && (!('paraQuien' in d) || d.paraQuien == null || (d.paraQuien is string && d.paraQuien.size() <= 80))
        && d.placeId is string
        && d.evento is string && d.evento.size() <= 160
        && isTime(d.llegada) && isTime(d.salida)
        && (d.horas == null || (d.horas is number && d.horas >= 0 && d.horas <= 24))
        && (d.valor == null || (d.valor is number && d.valor >= 0));
    }
    // Firma: PNG en base64 (máx. 150 KB ≈ 205.000 caracteres).
    function validProfile(d) {
      return d.keys().hasOnly(['nombre', 'firma', 'defaults', 'privacidadAceptadaEn', 'createdAt', 'updatedAt'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && (!('firma' in d) || d.firma == null || (d.firma is string && d.firma.size() <= 205000))
        && (!('defaults' in d) || d.defaults is map);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
    }

    match /permisos/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if owns() && tiene('planillas');
      // Crear y borrar lo hace el servidor (borra también el personal).
      allow create, update, delete: if false;

      match /staff/{staffId} {
        allow read: if owns() && tiene('planillas');
        allow write: if false;
      }
    }

    // Búsqueda de personal en todos los eventos (collectionGroup).
    match /{path=**}/staff/{staffId} {
      allow read: if owns() && tiene('planillas');
    }

    // Mis horas. Cuenta de cobro las lee para compararlas; Ajustes, para saber si un lugar está en uso.
    match /workLogs/{id} {
      allow read: if owns() && (tiene('horas') || tiene('cobro') || tiene('ajustes'));
      allow delete: if owns() && tiene('horas');
      allow create: if createsOwn() && tiene('horas') && validWorkLog(request.resource.data);
      allow update: if owns() && keepsOwner() && tiene('horas') && validWorkLog(request.resource.data);
    }

    // Lugares de trabajo. Crear se permite siempre al dueño: el registro los crea antes de tener permisos.
    match /workPlaces/{id} {
      allow read: if owns() && (tiene('horas') || tiene('planillas') || tiene('ajustes'));
      allow delete: if owns() && (tiene('horas') || tiene('ajustes'));
      allow create: if createsOwn()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60;
      allow update: if owns() && keepsOwner() && (tiene('horas') || tiene('ajustes'))
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60;
    }

    // Contadores del rate limit: solo el servidor.
    match /rateLimits/{id} {
      allow read, write: if false;
    }
  }
}
